{
  "name": "nextmusic-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "NextMusic Desktop — 主仓 RN(HD 形态) + react-native-web + Electron 壳",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite --port 5199\" \"wait-on tcp:5199 && cross-env VITE_DEV=1 electron .\"",
    "package": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "@react-navigation/stack": "^7.10.24",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "homepage": "https://github.com/mubeyout/NextMusic",
  "author": {
    "name": "MUBEY WORKS",
    "email": "mubeyout@users.noreply.github.com"
  }
}